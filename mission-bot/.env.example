# Copy this file to ".env" and fill it in. NEVER commit ".env" (it is in .gitignore).
# On a hosting platform, set these as environment variables / secrets instead.

# Required - Discord Developer Portal -> your application -> Bot -> Reset Token


# Optional - enables the level system (rank / levels commands).
# MongoDB Atlas -> Connect -> Drivers. Leave empty to disable levels.
MONGO_URI=

# Optional - where the JSON data files live (default: ./data).
# Point this at a persistent volume if your host wipes the disk on redeploy.
# DATA_DIR=/data

# Optional - only if your host needs the bot to answer HTTP health checks
# (also usable with UptimeRobot). Many hosts set PORT automatically.
# PORT=8080
